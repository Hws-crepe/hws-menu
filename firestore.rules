rules_version = '2';

// قواعد أمان Firestore — HWS CREPE (توفر الأصناف وأسعارها)
// الصق هذا الملف كاملاً في: Firebase Console ← Firestore Database ← Rules ← Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ غيّر هذا البريد إلى بريد حساب الأدمن الذي أنشأته في Authentication
    function adminEmail() {
      return "mohamedhapip86@gmail.com";
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == adminEmail();
    }

    // المستند يحوي فقط: id و updatedAt (وقت الخادم) و available (اختياري) و price (اختياري)
    function validItem(itemId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'available', 'price', 'updatedAt'])
          && d.keys().hasAll(['id', 'updatedAt'])
          && d.id == itemId
          && (!('available' in d) || d.available is bool)
          && (!('price' in d) || (d.price is int && d.price >= 0 && d.price <= 10000000))
          && d.updatedAt == request.time;
    }

    // توفر الأصناف وأسعارها لكل فرع: القراءة للجميع، الكتابة للأدمن فقط
    match /branches/{branchId}/items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && branchId.matches('^[a-z0-9_-]{1,40}$')
                            && validItem(itemId);
      allow delete: if isAdmin();
    }

    // المسار القديم (قبل فصل الفروع) — يبقى مؤقتاً حتى رفع النسخة الجديدة، ثم يمكن حذفه
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validItem(itemId);
      allow delete: if isAdmin();
    }

    // أي مجموعة أخرى: ممنوعة تماماً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
